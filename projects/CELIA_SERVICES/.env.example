# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://agent_admin:secure_pass_2025@localhost:5432/agent_system
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/agent_system

# Security Configuration
JWT_SECRET=super_secret_jwt_key_2025_change_in_production
JWT_EXPIRES_IN=24h

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Monitoring Configuration
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3002

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=super_secret_session_key_2025
SESSION_TIMEOUT=3600

# API Keys for External Integrations
STRIPE_API_KEY=sk_test_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Docker Configuration
DOCKER_REGISTRY=localhost:5000
COMPOSE_PROJECT_NAME=agent_system

# SSL Configuration (for production)
SSL_KEY_PATH=./ssl/private.key
SSL_CERT_PATH=./ssl/certificate.crt

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# Monitoring and Alerting
SENTRY_DSN=your_sentry_dsn_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_ML_FEATURES=true
ENABLE_EXPORT_FEATURES=true
ENABLE_NOTIFICATIONS=true

# Development Configuration
DEBUG=agent-system:*
HOT_RELOAD=true
SOURCE_MAPS=true