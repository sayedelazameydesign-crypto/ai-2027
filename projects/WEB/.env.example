# ============================================
# AI Providers System Configuration
# ============================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ============================================
# AI Provider API Keys
# ============================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ENABLED=true
OPENAI_PRIORITY=10
OPENAI_BASE_URL=
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3
OPENAI_MODELS=gpt-4,gpt-3.5-turbo

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_ENABLED=true
ANTHROPIC_PRIORITY=20
ANTHROPIC_BASE_URL=
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_MODELS=claude-3-5-sonnet-20241022,claude-3-haiku-20240307

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_ENABLED=true
GOOGLE_PRIORITY=30
GOOGLE_BASE_URL=
GOOGLE_TIMEOUT=30
GOOGLE_MAX_RETRIES=3
GOOGLE_MODELS=gemini-pro,gemini-pro-vision

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_ENABLED=true
DEEPSEEK_PRIORITY=40
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MODELS=deepseek-chat,deepseek-coder

# Groq
GROQ_API_KEY=your-groq-key-here
GROQ_ENABLED=true
GROQ_PRIORITY=50
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=3
GROQ_MODELS=mixtral-8x7b-32768,llama2-70b-4096

# HuggingFace
HUGGINGFACE_API_KEY=your-hf-token-here
HUGGINGFACE_ENABLED=true
HUGGINGFACE_PRIORITY=60
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co
HUGGINGFACE_TIMEOUT=30
HUGGINGFACE_MAX_RETRIES=3
HUGGINGFACE_MODELS=microsoft/DialoGPT-large

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_ENABLED=true
OPENROUTER_PRIORITY=70
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=3
OPENROUTER_MODELS=openai/gpt-3.5-turbo,anthropic/claude-2

# ============================================
# System Configuration
# ============================================

# Fallback Settings
FALLBACK_ENABLED=true
HEALTH_CHECK_INTERVAL=300
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=60
LOGGING_LEVEL=INFO
FALLBACK_TIMEOUT_MS=500

# Security Settings
ENABLE_SECURITY_SCANNING=true
MAX_CONTENT_LENGTH=1000000

# ============================================
# Vault Integration (Optional)
# ============================================

# HashiCorp Vault
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_MOUNT_POINT=secret
VAULT_NAMESPACE=

# AWS Secrets Manager
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Local Vault (Development)
LOCAL_VAULT_FILE=.vault.json

# ============================================
# Monitoring & Telemetry
# ============================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Redis (Optional for caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================
# Advanced Features
# ============================================

# PII Redaction
PII_REDACTION_ENABLED=true
PII_PRESERVE_FORMAT=true
PII_DETERMINISTIC_TOKENS=true

# Semantic Routing
SEMANTIC_ROUTING_ENABLED=true
SEMANTIC_CACHE_TTL=3600

# Cost Management
COST_MANAGEMENT_ENABLED=true
DEFAULT_DAILY_BUDGET=10.0
DEFAULT_MONTHLY_BUDGET=100.0

# Speculative Execution
SPECULATIVE_EXECUTION_ENABLED=true
SPECULATIVE_STRATEGY=parallel_backup
SPECULATIVE_BACKUP_DELAY_MS=2000
SPECULATIVE_MAX_PARALLEL=3