# ML Backend Environment Variables (Python FastAPI)
# نسخ هذا الملف إلى .env وتعبئة القيم المناسبة
# لا تضع أي قيمة حقيقية هنا — هذا الملف مُتتبَّع في Git (انظر docs/SECRETS.md)

# OpenAI API Key (للذكاء الاصطناعي)
OPENAI_API_KEY=

# Google AI Settings (Optional - if using Gemini)
GOOGLE_API_KEY=

# xAI (Grok) API Key (Optional)
XAI_API_KEY=

# Hugging Face Token (Optional - for Open Source Models)
HF_TOKEN=

# Database URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./enhanced_store.db

# Frontend URL for CORS (Production)
FRONTEND_URL=https://your-app.vercel.app

# Server Port (Optional - defaults to 8000)
PORT=8000
