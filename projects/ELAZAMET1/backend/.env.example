# Backend Environment Variables (Node.js)
# نسخ هذا الملف إلى .env وتعبئة القيم المناسبة
# لا تضع أي قيمة حقيقية هنا — هذا الملف مُتتبَّع في Git (انظر docs/SECRETS.md)

# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/EcommerceDB?retryWrites=true&w=majority

# Server Port (Optional - defaults to 5001)
PORT=5001

# Frontend URL for CORS (Production)
FRONTEND_URL=https://your-app.vercel.app

# Google API Key (Optional)
GOOGLE_API_KEY=

# xAI API Key (Optional)
XAI_API_KEY=

# Hugging Face Token (Optional)
HF_TOKEN=
