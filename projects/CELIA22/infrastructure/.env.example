# ═══════════════════════════════════════════════════
# CELIA Fashion Design - Environment Configuration
# ═══════════════════════════════════════════════════

# ═══════════════════════════════════════════════════
# DOMAIN & NETWORKING
# ═══════════════════════════════════════════════════
DOMAIN=celia.fashion
TZ=UTC

# ═══════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════
DB_USER=celia
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=celia_db

# ═══════════════════════════════════════════════════
# SECURITY & SECRETS
# Generate with: openssl rand -base64 32
# ═══════════════════════════════════════════════════
DIRECTUS_KEY=CHANGE_ME_RANDOM_KEY_32_CHARS
DIRECTUS_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_KEY_32_CHARS

# Admin Credentials
ADMIN_EMAIL=admin@celia.fashion
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Traefik Dashboard (generate with: htpasswd -nb admin password)
TRAEFIK_BASIC_AUTH=admin:$$apr1$$...

# N8n Access
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_N8N_PASSWORD

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ═══════════════════════════════════════════════════
# CLOUDFLARE (for SSL)
# ═══════════════════════════════════════════════════
CF_EMAIL=your-email@example.com
CF_API_TOKEN=your-cloudflare-api-token
# Get token from: https://dash.cloudflare.com/profile/api-tokens
# Needs: Zone:DNS:Edit permissions

# ═══════════════════════════════════════════════════
# AI SERVICES (Optional)
# ═══════════════════════════════════════════════════
OPENROUTER_KEY=
# Get from: https://openrouter.ai/keys
# Only needed if ENABLE_CLOUD_FALLBACK=true

# ═══════════════════════════════════════════════════
# SOCIAL INTEGRATIONS (Optional - for N8n)
# ═══════════════════════════════════════════════════
FB_APP_ID=
FB_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════
ENABLE_CLOUD_FALLBACK=false
ENABLE_MULTI_AGENT=false
ENABLE_LONG_TERM_MEMORY=false

# ═══════════════════════════════════════════════════
# NOTIFICATIONS (Optional)
# ═══════════════════════════════════════════════════
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WATCHTOWER_EMAIL_FROM=
WATCHTOWER_EMAIL_TO=

# ═══════════════════════════════════════════════════
# ADVANCED SETTINGS (Don't change unless you know what you're doing)
# ═══════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=celia
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
