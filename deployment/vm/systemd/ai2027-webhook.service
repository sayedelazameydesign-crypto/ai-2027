# YCloud / WhatsApp webhook receiver ($0). Verifies signatures, stages replies as
# pending_approval, sends nothing by itself. Public only through Caddy (/webhook, /healthz).
[Unit]
Description=AI-2027 WhatsApp/YCloud webhook receiver (stage-only, $0)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ai2027
Group=ai2027
WorkingDirectory=/opt/ai2027
EnvironmentFile=/etc/ai2027/webhook.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=AI2027_FREE_STACK_DB=/var/lib/ai2027/webhook/free_stack.db
StateDirectory=ai2027/webhook
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 scripts/free_stack_runner.py --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
MemoryMax=256M
TasksMax=128
# ── hardening: read-only OS + code, private /tmp, no privilege escalation ──
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
