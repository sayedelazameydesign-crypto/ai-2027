# Live Agent kernel API (stdlib only). Loopback only; operator/reader credentials are
# generated by bootstrap.sh into /etc/ai2027 and never leave the VM.
[Unit]
Description=AI-2027 Live Agent (loopback, verified kernel runs)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ai2027
Group=ai2027
WorkingDirectory=/opt/ai2027
EnvironmentFile=/etc/ai2027/live-agent.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=HOST=127.0.0.1 PORT=8090
Environment=AI2027_LIVE_RUNTIME_DIR=/var/lib/ai2027/live-agent
Environment=AI2027_MAX_DISK_MB=1024 AI2027_MAX_RUNS=20000
StateDirectory=ai2027/live-agent
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 deployment/live_server.py
Restart=always
RestartSec=5
MemoryMax=512M
TasksMax=128
# ── hardening: read-only OS + code, private /tmp, no privilege escalation ──
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
