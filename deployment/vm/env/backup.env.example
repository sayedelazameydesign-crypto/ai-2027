# /etc/ai2027/backup.env — read by ai2027-backup.service (root only in practice).
AI2027_BACKUP_KEEP_DAYS=14
# Off-VM copy (strongly recommended): an rclone remote defined in /etc/ai2027/rclone.conf,
# ideally a `crypt` remote wrapping Google Drive or Dropbox. Example: ai2027-crypt:backups
AI2027_BACKUP_RCLONE_REMOTE=
