# /etc/ai2027/webhook.env — read ONLY by ai2027-webhook.service (root:root 0600 — systemd reads it as root, the service user never can).
# Fill the values on the VM, never in Git. Then: sudo systemctl restart ai2027-webhook
WHATSAPP_PROVIDER=ycloud
AI2027_MAX_FREE_REPLIES_PER_DAY=10

# REQUIRED to accept YCloud deliveries: the endpoint's signing secret from the YCloud
# dashboard (Developers -> Webhooks -> your endpoint). Without it every POST gets 401.
YCLOUD_WEBHOOK_SECRET=

# Meta verify token for GET /webhook (only if you also use the Meta Cloud API path).
# Must NOT be a URL; if YCLOUD_WEBHOOK_SECRET is empty this value is also used as the
# YCloud signing secret.
AI2027_WHATSAPP_WEBHOOK=

# Used only once approved-reply dispatch is wired (Phase 7 of the plan); the receiver
# itself never sends. Keep empty until then.
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM=

# Channel assistant drafts (docs/CHANNEL-ASSISTANT.md §11). 0 = fixed default replies.
# 1 = a free model drafts general-conversation replies; coupons/codes stay deterministic
# and every draft is still pending_approval. Needs the unit to run with
# /opt/ai2027/python-2027/.venv/bin/python (stdlib python3 has no pydantic) and at least
# one free-tier key below; BudgetGuard keeps the spend ceiling at $0.
AI2027_ASSISTANT_ENABLED=0
AI2027_MAX_SPEND_USD=0
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
