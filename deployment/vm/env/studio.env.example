# /etc/ai2027/studio.env — read ONLY by ai2027-studio.service (root:root 0600 — systemd reads it as root, the service user never can).
# All optional. With nothing set, Studio runs the $0 offline fallback.
# AI2027_MAX_SPEND_USD=0 is forced by the unit file; a paid/unknown-cost call is refused.
#
# Free-tier providers (each key only enables its own provider):
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Must be "openrouter/free" or "<vendor>/<model>:free" — anything else is refused at $0.
OPENROUTER_MODEL=openrouter/free
