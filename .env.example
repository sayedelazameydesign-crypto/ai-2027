# AI-2027 — environment template
#
# WHAT THIS FILE IS
#   A template listing the NAME of every environment variable the project
#   reads, what each one is for, and what happens when it is missing.
#
# WHAT THIS FILE IS NOT
#   It contains NO secret values, and it must never contain any. Every
#   value below is either empty or an obvious placeholder.
#
# HOW TO USE IT
#   cp .env.example .env.local     # .env.local is gitignored
#   $EDITOR .env.local              # fill in only what you actually have
#
#   The project NEVER reads .env or .env.local automatically — there is no
#   dotenv loader in the codebase, on purpose: a secret that is silently
#   loaded from a file is a secret that ends up in a shell history or a
#   CI log. Export the variables yourself, or source the file explicitly:
#
#   set -a; . ./.env.local; set +a
#
# THEN
#   python scripts/doctor.py        # confirms the environment is usable
#
# THE REGISTRY OF RECORD
#   docs/SECRETS.md is the authoritative registry: it records who consumes
#   each secret, what it does, and how to rotate it. This file is the
#   quick-start view of the same information. If the two disagree,
#   docs/SECRETS.md is right.
#
# THE ONE RULE
#   A credential VALUE never goes in this file, in any other tracked file,
#   in a commit message, or in a chat. Only the NAME goes here.


# ===========================================================================
# 1. POSTURE — the fail-closed defaults
# ===========================================================================
# These four decide how the system behaves when everything else is missing.
# Leave them as they are unless you have a specific reason not to.

# Spend ceiling in USD. 0 (the default) refuses every paid call AND every
# call whose cost cannot be proven to be zero. Unset behaves as 0.
# Do not raise this to "try one paid request" — the refusal is the feature.
AI2027_MAX_SPEND_USD=0

# 1 = the whole application refuses writes. Required for any public
# instance. The Render blueprint sets it to 1 for exactly this reason.
AI2027_READ_ONLY=1

# Extra model ids you declare free on a provider's own free plan, comma
# separated. It does NOT make a paid model free, and it CANNOT reclassify
# a protected provider such as OmniRouters.
AI2027_FREE_MODELS=

# 1 permits calls whose cost is unknown. This is AUTHORISATION, not a
# financial ceiling: the call still spends real money, it just stops being
# refused. Leave it unset under a $0 policy.
AI2027_ALLOW_UNKNOWN_COST=0

# Measurable companion to ALLOW_UNKNOWN_COST: because unknown-cost calls
# never advance MAX_SPEND (no cost estimate), admission is capped at this
# many completed calls per UTC day. Unset = 5. 0 = refuse unknown-cost calls
# even when ALLOW_UNKNOWN_COST=1. Non-numeric values fail closed to 0.
AI2027_UNKNOWN_COST_DAILY_LIMIT=5


# ===========================================================================
# 2. PROVIDER CREDENTIALS — all optional
# ===========================================================================
# The project ships a deterministic $0 offline fallback, so it works with
# NONE of these set. Each one only enables the feature that consumes it.
# A missing key disables a feature; it is never an error.

# OpenRouter. Only "openrouter/free" or a "<vendor>/<model>:free" id may be
# used under the $0 policy above; anything else is classified as having an
# unknown cost and is refused.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq. Free tier only under the $0 policy.
GROQ_API_KEY=
GROQ_MODEL=

# Google AI Studio. NOT assumed free — its cost is classified, not ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM. NOT assumed free — its cost is classified, not ignored.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Ollama Cloud. Classified as unknown cost, so it is blocked at $0 even
# when the key is present. The LOCAL Ollama below needs no key at all.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OmniRouters. Not free by default on a new account, and it is on the
# protected list: it cannot be reclassified as free, not even by adding it
# to AI2027_FREE_MODELS. OMNIROUTERS_MODEL is required as well — without it
# the provider is never built and no request is ever sent.
OMNIROUTERS_API_KEY=
OMNIROUTERS_MODEL=


# ===========================================================================
# 3. CONNECTORS HUB — optional
# ===========================================================================
# The Studio connectors catalogue. Without the token that one route reports
# "token_missing" and everything else keeps working.

CONNECTORS_HUB_URL=http://127.0.0.1:8765
CONNECTORS_HUB_API_TOKEN=


# ===========================================================================
# 4. DEPLOYMENT — optional
# ===========================================================================
# Only needed to deploy from CI. For the Render Blueprint, enter the
# secrets in the Render dashboard instead: the blueprint declares them with
# "sync: false" so they never land in Git.

RENDER_API_KEY=
RENDER_SERVICE_NAME=ai-2027-live-agent
RENDER_SERVICE_ID=


# ===========================================================================
# 5. AGENT SUBSTRATE — optional, cluster access
# ===========================================================================
# AGENT_SUBSTRATE_KUBECONFIG is deliberately SEPARATE from the
# AGENT_SUBSTRATE_KUBECONFIG used by the substrate controller. Do not
# point one at the other.

AGENT_SUBSTRATE_KUBECONFIG=
SUBSTRATE_API_TOKEN=
SUBSTRATE_ACTOR_MASTER_KEY=


# ===========================================================================
# 6. SANDBOX AND ALERTS — optional
# ===========================================================================

# E2B runs code in a temporary microVM. It can consume credit.
E2B_API_KEY=

# Stage-three degradation alert webhook.
EMBER_ALERT_WEBHOOK=


# ===========================================================================
# 7. STORAGE AND TELEMETRY — optional
# ===========================================================================
# Local paths for the CELIA memory store and the telemetry sink. These are
# paths, not secrets.

AI2027_CELIA_MEMORY_DB=
AI2027_TELEMETRY_DIR=
AI2027_SESSION_LEASE=
AI2027_OBSERVABILITY_MODE=
AI2027_OLLAMA_PROFILE=

# ===========================================================================
# 8. P1 PROACTIVE WATCHER AND APPROVAL BOT — optional
# ===========================================================================
# src/watchers/proactive_watcher.py polls Gmail/Calendar into the
# "My Personal Agent — Memory (P0)" sheet; src/watchers/approval_bot.py
# delivers pending pa_approvals cards over Telegram and applies the votes.
# Both are read-first and fail-closed: without PA_MEMORY_SHEET_ID they cannot
# open the sheet, and with PA_APPROVAL_ALLOWED_SENDERS empty nobody may vote
# (deny-by-default, AD-004). Tokens are secrets — never commit them.

PA_MEMORY_SHEET_ID=
WATCHER_INTERVAL_SEC=900
APPROVAL_BOT_INTERVAL_SEC=300
PA_APPROVAL_BOT_TOKEN=
PA_APPROVAL_CHAT_ID=
PA_APPROVAL_ALLOWED_SENDERS=
PA_APPROVAL_API_BASE=https://api.telegram.org

# --- 9. Passkey approval signing (ADR-0006) ---
# The approval card can carry a Passkey (WebAuthn) voting link served by the
# Cloudflare Worker in worker/approval-worker/ (HTTPS, e.g. workers.dev).
# The Worker signs approval_id|action|payload_hash|decision|exp with Ed25519;
# src/executors/governed_executor.py verifies it against the public key and
# only then executes a pending approval (fail-closed when the key is absent).
# The inline Telegram buttons stay as the transitional fallback until the
# passkey path proves itself in production (removal is an ADR decision).
PA_APPROVAL_VOTE_BASE_URL=
PA_APPROVAL_SIGNING_PUBKEY=

# --- 10. Apps Script deploy (manual, .github/workflows/deploy-apps-script.yml) ---
# APPS_SCRIPT_ID is the target Apps Script project ID (Celia Fashion Design).
# CLASPRC_JSON is the contents of ~/.clasprc.json after `clasp login`.
# Both are repository secrets in CI; here they are local-only names.
# Never commit their values. The deploy workflow is manual-only on main.
APPS_SCRIPT_ID=
CLASPRC_JSON=

# --- 11. WAAPI notifications (opt-in, docs/WAAPI-INTEGRATION-PLAN.md) ---
# WhatsApp companion channel via waapi.app. The token is dual-homed: the
# same value lives in the GitHub Actions secret WAAPI_API_TOKEN (read-only
# live probe: .github/workflows/waapi-live-probe.yml) and here for the
# runtime — copy it once by hand; never commit it (.env is gitignored).
# Fail-closed at every step: no token -> no message; PA_WAAPI_NOTIFY=0
# disables the companion; the notify path may only reach WAAPI_OWNER_CHAT_ID;
# and whatsapp.send executes only through the governed executor after an
# approval vote + single-use consume (docs/WAAPI-INTEGRATION-PLAN.md).
WAAPI_API_TOKEN=
WAAPI_INSTANCE_ID=
WAAPI_OWNER_CHAT_ID=
PA_WAAPI_NOTIFY=0

# --- 11. Alibaba Cloud Model Studio / Qwen (opt-in provider) ---------------
# OpenAI-compatible provider from the official Model Studio docs
# (docs/QWEN-PROVIDER-INTEGRATION.md). NOT in the default provider chain:
# it is built only on explicit request, classified UNKNOWN_COST, and
# NON_RECLASSIFIABLE — blocked while AI2027_MAX_SPEND_USD=0 even with the
# key set. QWEN_MODEL has no default (ids rotate: qwen4-max is current as of
# 2026-11, qwen3.8-max still exists — pick from your model list). The free
# quota is 1M tokens/90 days; the console's "Free Quota Only" setting (off
# by default) stops the service at quota end instead of billing you.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=ap-southeast-1
QWEN_MODEL=
