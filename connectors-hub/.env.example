# This file is a template only. Never put credentials in this file.
# API access tokens and encryption keys belong in the operating-system keyring.

# Optional Google OAuth account hint; not a credential and not a guarantee that
# the account has authorized this local application.
CONNECTORS_HUB_GOOGLE_LOGIN_HINT=

# Optional Supabase URL, e.g. https://<project-ref>.supabase.co
# Store the publishable/anon key and a user-scoped JWT separately in the OS keyring.
CONNECTORS_HUB_SUPABASE_URL=
# Comma-separated table allowlist for Supabase search and row reads. Empty means no table access.
CONNECTORS_HUB_SUPABASE_SEARCH_TABLES=
# Comma-separated readable/searchable columns for the allowlisted Supabase tables.
CONNECTORS_HUB_SUPABASE_SEARCH_COLUMNS=

# Local inference uses LM Studio's OpenAI-compatible loopback server by default.
# Start its local server and load a model in LM Studio first. No key is needed.
CONNECTORS_HUB_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
CONNECTORS_HUB_LM_STUDIO_MODEL=local-model
# Conservative Hub context budget. Set no higher than LM Studio's loaded context
# and the VRAM budget supports; the Hub uses a tokenizer-independent byte estimate.
CONNECTORS_HUB_REASONING_CONTEXT_TOKENS=8192
# Conservative output cap; increase only after checking model VRAM/context settings.
CONNECTORS_HUB_REASONING_MAX_OUTPUT_TOKENS=1024

# Optional default NVIDIA NIM model ID (not a secret). The API key belongs in the OS keyring.
CONNECTORS_HUB_NVIDIA_MODEL=

# Optional persistent state path. By default state is stored in the current user's
# local application data directory (Windows: %LOCALAPPDATA%\ConnectorsHub).
CONNECTORS_HUB_DATA_DIR=
