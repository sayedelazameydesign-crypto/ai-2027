# AI-2027 Python 2027 Protocol — Environment Template (NEVER commit a real .env)
# Leave all keys blank to run 100% offline with deterministic fallback ($0).
# GitHub Actions supplies GEMINI_API_KEY and NVIDIA_API_KEY automatically on gated main runs.

# Local Ollama ($0 local inference, loopback only)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b

# Google AI Studio free tier (also an existing GitHub Actions secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM API Catalog (also an existing GitHub Actions secret)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Groq free tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter :free tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Runtime guards
AI2027_READ_ONLY=0
AI2027_LOG_LEVEL=INFO
AI2027_OTEL_CONSOLE=0
